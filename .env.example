# Workadu MCP Server Environment Variables
# Copy to .env and fill in your values

# Base URL of your Workadu instance (without trailing slash)
WORKADU_API_URL=https://app.workadu.com

# Your Workadu API key (for stdio / Basic Auth mode)
WORKADU_API_KEY=your-api-key-here

# OAuth 2.0 Protected Resource settings (for HTTP/SSE mode)
# WORKADU_OAUTH_URL=https://app.workadu.com
# WORKADU_JWKS_URL=https://app.workadu.com/.well-known/jwks.json
# MCP_RESOURCE_URL=https://mcp.workadu.com
# WORKADU_OAUTH_SCOPES=wefiscal:read wefiscal:write
